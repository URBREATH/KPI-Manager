    "vue-i18n": "^9.2.2",
    "vue-router": "^4.2.2",
    "vuetify": "^3.6",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.21.8",
    "@vue/cli-plugin-babel": "~5.0.8",
